{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/check-constraints.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/check-scaffold.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/auto-gate.py",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
